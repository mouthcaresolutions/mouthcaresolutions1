generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  passwordHash String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutoBloggerConfig {
  id               String   @id @default(cuid())
  enabled          Boolean  @default(true)
  postsPerDay      Int      @default(3)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  categories       String   @default("General Dentistry,Cosmetic Dentistry,Oral Hygiene,Pediatric Dentistry,Implants & Prosthodontics,Orthodontics,Preventive Dental Care")
  status           String   @default("idle")
  totalGenerated   Int      @default(0)
  failedCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AutoBloggerLog {
  id          String   @id @default(cuid())
  status      String
  postsCreated Int     @default(0)
  postsFailed  Int     @default(0)
  error       String?
  duration    Int      @default(0)
  ranAt       DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  metaTitle   String?
  metaDesc    String?
  content     String
  excerpt     String?
  category    String
  keywords    String?
  status      String   @default("published")
  author      String   @default("Mouth Care Solutions")
  scheduledAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([slug])
  @@index([scheduledAt])
  @@index([status])
}
