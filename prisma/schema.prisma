generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  metaTitle   String?
  metaDesc    String?
  content     String
  excerpt     String?
  category    String
  keywords    String?
  status      String   @default("published")
  author      String   @default("Mouth Care Solutions")
  scheduledAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([slug])
  @@index([scheduledAt])
}