# ===== MOUTH CARE SOLUTIONS - Environment Variables =====
# Copy these to Vercel → Settings → Environment Variables

# Database (Turso)
DATABASE_URL="libsql://mcs-dental-USERNAME.turso.io"
DIRECT_DATABASE_URL="libsql://mcs-dental-USERNAME.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
JWT_SECRET="change-this-to-a-random-40-char-string"

# Site
NEXT_PUBLIC_SITE_URL="https://mouthcaresolutions.com"

# AI (for auto-blogger) - ZAI SDK
ZAI_API_KEY=""

# Cron secret (for auto-blogger cron calls)
CRON_SECRET="make-up-a-random-long-string-here"
