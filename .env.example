# ===== MOUTH CARE SOLUTIONS - Environment Variables =====
# Copy these to Vercel → Settings → Environment Variables

# Database (Turso)
DATABASE_URL="libsql://mcs-dental-USERNAME.turso.io"
DIRECT_DATABASE_URL="libsql://mcs-dental-USERNAME.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Admin - IMPORTANT: Set a strong password before first deploy
# The admin user is only seeded if ADMIN_PASSWORD is set and no admin exists
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_STRONG_PASSWORD"
JWT_SECRET="CHANGE_THIS_TO_A_RANDOM_40_CHAR_STRING_AT_LEAST"

# Site
NEXT_PUBLIC_SITE_URL="https://mouthcaresolutions.com"

# AI (for auto-blogger) - ZAI SDK
ZAI_API_KEY=""

# Image APIs (for auto-blogger blog images)
PEXELS_API_KEY="jDx3ifHmi9EWorIAhVRBAcJRt3g1O0WJYncXhXASuhAwRSUNnNsjKQRA"
PIXABAY_API_KEY="42656438-a08a600c1ba6fcda4e71e5869"

# Cron secret (for auto-blogger cron calls)
# IMPORTANT: Pass as Authorization header ONLY, never in URL query string
CRON_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING"
